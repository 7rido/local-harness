#!/usr/bin/env node
// A stand-in for the docker command, used through LH_DOCKER in the tests. It records its arguments and stdin and prints canned
// output. STUB_LOG: file to append JSON lines to. STUB_MODE: ok (default), hang, big, noconnect, exit3.
'use strict';
const fs = require('node:fs');
const argv = process.argv.slice(2);
const i = argv.findIndex((a) => ['run', 'info', 'rm'].includes(a));
const sub = i >= 0 ? argv[i] : '';
const mode = process.env.STUB_MODE || 'ok';
let stdin = '';
const finish = () => {
  if (process.env.STUB_LOG) fs.appendFileSync(process.env.STUB_LOG, JSON.stringify({ argv, sub, stdin, docker_host: process.env.DOCKER_HOST || null }) + '\n');
  if (mode === 'noconnect') { process.stderr.write('Cannot connect to the Docker daemon (stub)\n'); process.exit(sub === 'run' ? 125 : 1); }
  if (sub !== 'run') process.exit(0);
  if (mode === 'hang') { setTimeout(() => {}, 60000); return; }
  if (mode === 'big') { process.stdout.write('x'.repeat(10000)); process.exit(0); }
  if (mode === 'exit3') { process.stdout.write('oops'); process.stderr.write('bad'); process.exit(3); }
  process.stdout.write(process.env.STUB_OUT !== undefined ? process.env.STUB_OUT : '4\n');
  process.exit(0);
};
if (sub === 'run') { process.stdin.on('data', (d) => { stdin += d; }); process.stdin.on('end', finish); } else finish();
